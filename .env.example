# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
# Origin of the Next.js app — used by the session middleware to check who is
# signed in (defaults to http://localhost:3000).
WEB_ORIGIN=http://localhost:3000

# MongoDB Atlas — either a full URI...
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.8evmyeo.mongodb.net/
# ...or these two (the URI is built from them when MONGODB_URI is absent).
# DB_USER=
# DB_PASSWORD=

# Optional. When set, GET /users is enabled and requires an x-admin-key header.
# ADMIN_API_KEY=

# Vendor subscription (upgrade): Stripe secret key (from the frontend repo,
# apps/web/.env.local — lib/stripe.ts reads it there).
# STRIPE_SECRET_KEY=
# Optional — public URL of the Next.js app, used for Stripe success/cancel
# redirects (defaults to the request Host header).
# SITE_URL=http://localhost:3000
